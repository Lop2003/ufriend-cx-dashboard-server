# UFriend CX Dashboard - Server Environment Configuration Template

# Server Port
PORT=3000

# Server Environment (development/production)
APP_ENV=development

# MongoDB Connection parameters
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ufriend_cx

# Lark OAuth (https://open.larksuite.com)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=http://localhost:3000/api/auth/lark/callback
LARK_BASE_URL=https://open.larksuite.com
LARK_ACCOUNTS_URL=https://accounts.larksuite.com
# scope คั่นด้วย space — ต้องมี offline_access ถ้าต้องการ refresh_token
LARK_OAUTH_SCOPE=offline_access

# Frontend URL สำหรับ redirect หลัง login
CLIENT_URL=http://localhost:5173

# Session Token Encryption (AES-256-GCM)
# 32-byte key แปลงเป็น hex (64 ตัวอักษร) — ใช้เข้ารหัส access_token/refresh_token ใน database
# สร้าง key: openssl rand -hex 32
# ถ้าไม่ตั้งค่า → token จะเก็บเป็น plain text (สำหรับ development เท่านั้น)
SESSION_ENCRYPTION_KEY=

